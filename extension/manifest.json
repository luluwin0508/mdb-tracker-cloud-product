{
  "manifest_version": 3,
  "name": "MDB Tracker Sync",
  "version": "2.1",
  "description": "点击工具栏图标，把当前 MDB 页面同步到云端看板",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "同步本页到 MDB 看板"
  },
  "options_page": "options.html",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "*://www.worldbank.org/*",
    "*://www.adb.org/*",
    "*://www.afdb.org/*",
    "*://www.aiib.org/*",
    "https://mdb-fdcompliance.xyz/*",
    "https://roaring-gnome-273245.netlify.app/*"
  ]
}
